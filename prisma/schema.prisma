// Gasp data model — SQLite for local dev/demo, designed to port 1:1 to Postgres.
// Enum-like fields use String because SQLite has no native enums; allowed
// values are documented per field and enforced in lib/validate.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  // Contact email, collected at signup (stored lowercased). Nullable so
  // pre-email accounts and seed data stay valid; new signups always set it.
  email          String?   @unique
  // Set when the address is confirmed. Null = unverified. No mail provider is
  // wired up yet, so today everyone is unverified; the column lets the verify
  // + email-reset flow switch on later with no migration.
  emailVerifiedAt DateTime?
  displayName String
  avatarEmoji String   @default("🙂")
  avatarColor String   @default("#FFD166")
  bio         String   @default("")
  // "watching" | "creating" — which mode the user last toggled to
  mode        String   @default("watching")
  // "user" | "admin" — admins get the moderation dashboard.
  role        String   @default("user")
  // Suspended accounts can't sign in; their content is hidden everywhere.
  suspended   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Creator-profile fields (filled in when they switch to creating)
  creatorAbout   String @default("")
  creatorTools   String @default("") // JSON array of strings: tools/equipment
  creatorProcess String @default("")
  // Optional demo reel / intro video pinned to the top of the creator page.
  // Plain id (no FK) so deleting the video can't break the profile; the page
  // resolves it and silently skips if missing/unpublished.
  featuredVideoId String @default("")

  passwordHash String
  // Scrypt hash of a one-time recovery code shown at signup — the only way
  // to reset a password without email. Rotated on each use.
  recoveryCodeHash String @default("")
  // One-time email-flow tokens, stored as SHA-256 of the emailed token (the
  // raw token only ever travels inside the link). Null = no outstanding link.
  emailVerifyTokenHash String?
  emailVerifyExpires   DateTime?
  resetTokenHash       String?
  resetExpires         DateTime?
  // Declared age (birth year). Under 13 is blocked at signup; under 18 never
  // sees mature content. Null = legacy account (treated as under-18-safe).
  birthYear    Int?

  videos        Video[]
  series        Series[]
  channels      Channel[]
  ratings       Rating[]
  comments      Comment[]
  follows       Follow[]
  watchEvents   WatchEvent[]
  sentFriend    Friendship[] @relation("requester")
  gotFriend     Friendship[] @relation("addressee")
  sessions      Session[]
  notifications Notification[]
  reportsFiled   Report[] @relation("reportsFiled")
  blocksMade     Block[]  @relation("blocksMade")
  blocksReceived Block[]  @relation("blocksReceived")
  creatorFollowing CreatorFollow[] @relation("creatorFollower")
  creatorFollowers CreatorFollow[] @relation("creatorFollowed")
  seriesFollows    SeriesFollow[]
}

// Following a creator (celebrate makers): follower → creator, a directed edge
// distinct from channel follows.
model CreatorFollow {
  followerId String
  follower   User     @relation("creatorFollower", fields: [followerId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User     @relation("creatorFollowed", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, creatorId])
  @@index([creatorId])
}

// Following a mini-series so new episodes are easy to come back to.
model SeriesFollow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, seriesId])
  @@index([seriesId])
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// A mini-series / microdrama container. Every video can stand alone
// (seriesId null) or be an episode.
model Series {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  videos      Video[]
  followers   SeriesFollow[]

  @@index([creatorId])
}

model Video {
  id            String  @id @default(cuid())
  creatorId     String
  creator       User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  seriesId      String?
  series        Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  episodeNumber Int?
  title         String
  description String   @default("")
  backstory   String   @default("") // "how I made it / why" — creator insight
  src         String // /videos/xxx.mp4 locally; object-storage/CDN URL in prod
  thumb       String // poster image URL
  durationSec Int
  category    String // one of lib/constants CATEGORIES
  tags        String   @default("") // JSON array of strings
  // "draft" (creator-only) | "pending" (awaiting moderation when review
  // mode is on) | "published" (public once publishAt<=now or null) |
  // "removed" (taken down by moderators — creator sees why in their studio).
  status      String    @default("published")
  publishAt   DateTime?
  // Creator flagged mature themes; moderators can correct it. Mature
  // content is kept out of kid surfaces and labeled on the player.
  mature      Boolean   @default(false)
  // When the creator confirmed they own/control the rights at upload.
  rightsConfirmedAt DateTime?
  // WebVTT captions (empty = none). Served to the player as a Blob track.
  captionsVtt String   @default("")
  createdAt   DateTime @default(now())

  // Denormalized rating counters — recomputed from aggregates inside the same
  // transaction as every rating write (never incremented blindly).
  burntCount  Int @default(0)
  poppedCount Int @default(0)
  butterCount Int @default(0)
  // Cached all-time Popcorn Score (Bayesian-smoothed % popped, 0-100).
  popcornScore Int @default(0)
  viewCount    Int @default(0)

  ratings     Rating[]
  comments    Comment[]
  channelRefs ChannelVideo[]
  watchEvents WatchEvent[]

  @@index([creatorId])
  @@index([seriesId])
  @@index([category])
  @@index([createdAt])
  @@index([popcornScore])
  @@index([status, createdAt])
  // Basic title search until a real search engine lands.
  @@index([title])
}

model Channel {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String   @default("📺")
  description String   @default("")
  // A genre key from lib/constants CATEGORIES, or "custom".
  category    String   @default("custom")
  // When category is "custom": the maker's own category name ("Cozy Vibes"),
  // represented by `emoji` or an uploaded `coverUrl` photo.
  customCategory String @default("")
  coverUrl       String @default("")
  // Prebuilt channels have no owner and are curated by the platform.
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPrebuilt  Boolean  @default(false)
  // "normal" | "surprise" (computed per-request) | "weekly" (mirror of weekly chart)
  kind        String   @default("normal")
  createdAt   DateTime @default(now())

  videos    ChannelVideo[]
  followers Follow[]

  @@index([ownerId])
}

model ChannelVideo {
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([channelId, videoId])
  @@index([videoId])
}

model Rating {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // "burnt" (not for me) | "popped" (liked it) | "butter" (loved it)
  value     String
  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([videoId, createdAt]) // weekly chart scans
}

model Comment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  text        String
  // Optional timecode (seconds into the video) the comment is pinned to.
  timecodeSec Int?
  // The video's creator can pin one comment to the top.
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([videoId, timecodeSec])
  @@index([videoId, createdAt])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  // Canonical pair key (sorted "idA:idB") — one row per pair regardless of
  // who asked first, enforced by the database.
  pairKey     String   @unique
  // "pending" | "accepted"
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, channelId])
  @@index([channelId])
}

// A report against a video, a creator, or a comment. The admin dashboard
// works these; every decision is recorded on the row.
model Report {
  id         String  @id @default(cuid())
  reporterId String
  reporter   User    @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  // "video" | "creator" | "comment"
  targetType String
  videoId    String?
  creatorId  String? // the reported user's id (creator or commenter)
  commentId  String?
  // "not_for_kids" | "harmful" | "hateful" | "copyright" | "spam" | "other"
  reason     String
  detail     String   @default("")
  // "open" | "resolved"
  status     String   @default("open")
  // What the moderator did: "dismissed" | "video_removed" | "creator_suspended" | "comment_removed" | note text
  resolution String   @default("")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([videoId])
  @@index([creatorId])
}

// Viewer-level block: the blocked creator's videos and comments disappear
// for the blocker everywhere in the app.
model Block {
  blockerId String
  blocker   User     @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model WatchEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
  // How far they got (seconds) — powers Continue Watching + completion rate.
  progressSec Int     @default(0)
  completed   Boolean @default(false)

  @@index([userId, watchedAt])
  @@index([videoId, watchedAt]) // per-day analytics scans
}

// Lightweight in-app notifications: friend activity and new videos in
// channels you follow. `href` is where tapping it goes.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "friend_request" | "friend_accept" | "channel_video"
  type      String
  text      String
  href      String   @default("/")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
